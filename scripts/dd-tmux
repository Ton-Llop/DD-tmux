#!/usr/bin/env bash
# dd-tmux [start|stop|log|hooks]: starts the backend in the background (if not running) and opens the web.
# `dd-tmux start` only starts it, without opening the browser (used by the tmux hook).
# `dd-tmux hooks` enables edit tracking (Code tab) for every Claude Code session.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/dd-tmux.log"
PORT="$(sed -n 's/^TD_PORT=//p' "$ROOT/backend/.env")"; PORT="${PORT:-8765}"
running() { pgrep -f "uvicorn app.main:app.*--port $PORT" >/dev/null; }

case "${1:-}" in
  stop) pkill -f "uvicorn app.main:app.*--port $PORT" && echo "dd-tmux stopped"; exit ;;
  log)  exec tail -f "$LOG" ;;
  hooks) exec python3 "$ROOT/scripts/install_hooks.py" ;;
esac

if ! running; then
  mkdir -p "$(dirname "$LOG")"
  nohup bash "$ROOT/scripts/start.sh" >"$LOG" 2>&1 &
  for _ in $(seq 20); do curl -s -o /dev/null "http://127.0.0.1:$PORT" && break; sleep 0.5; done
fi
[ "${1:-}" = start ] && exit 0
URL="http://localhost:$PORT"
echo "dd-tmux at $URL  (dd-tmux stop | dd-tmux log)"
# Opens the Windows browser from WSL; on plain Linux uses xdg-open
{ command -v wslview && wslview "$URL" || explorer.exe "$URL" || xdg-open "$URL"; } >/dev/null 2>&1 || true
